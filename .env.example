# Copier ce fichier en ".env" (qui, lui, n'est jamais envoyé sur GitHub),
# puis remplacer les valeurs si besoin. Les valeurs ci-dessous sont des valeurs
# de développement local uniquement.

# --- MinIO (Data Lake, API compatible S3) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=urbanhub
MINIO_ROOT_PASSWORD=urbanhub123
BUCKET_RAW=raw
BUCKET_CLEAN=clean
BUCKET_CURATED=curated

# --- PostgreSQL (couche serving pour Superset) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=urbanhub
POSTGRES_USER=urbanhub
POSTGRES_PASSWORD=urbanhub123

# --- Spark ---
SPARK_MASTER_URL=spark://localhost:7077

# --- Superset ---
SUPERSET_SECRET_KEY=change-me-local-only
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# --- OpenAQ (Dev 3) : clé gratuite à créer sur https://explore.openaq.org ---
OPENAQ_API_KEY=
